---
import Base from '../../../layouts/Base.astro';
import { READY_CODES } from '../../../i18n/locales';
import { parentsFr, parentsEn } from '../../../i18n/pages/parents';
import { SITE } from '../../../config/site';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const p = lang === 'fr' ? parentsFr : parentsEn;
const test = !SITE.consentEndpoint;
---
<Base lang={lang} slug="parents" title={p.title} description={p.lead} noindex>
  <section class="hero" style="padding-block:clamp(40px,7vw,80px)"><div class="wrap"><h1>{p.h1}</h1><p class="lead">{p.lead}</p></div></section>
  <section class="alt"><div class="wrap prose">
    {p.intro.map((x) => <p>{x}</p>)}
    <p><a href={`/${lang}/rules/`} target="_blank" rel="noopener">{p.rules}</a> | <a href={`/${lang}/privacy/`} target="_blank" rel="noopener">{p.privacy}</a></p>
  </div></section>
  <section><div class="wrap prose">
    <form id="pc" class="form" novalidate data-endpoint={SITE.consentEndpoint} data-lang={lang} data-err={p.err} data-sending={p.sending}
      data-done-accepted={p.done.accepted} data-done-refused={p.done.refused} data-done-withdrawn={p.done.withdrawn}>
      {test && <p class="banner">{p.testBanner}</p>}
      <p class="error" id="pcmsg" role="alert" hidden>{p.noToken}</p>
      <p class="ok" id="pcok" role="status" hidden></p>
      <div id="main-form">
        <fieldset>
          <label>{p.name}<input name="parentName" required maxlength="80" autocomplete="name" /></label>
          <div class="opts"><span class="lab">{p.relation}</span>
            <label class="chk"><input type="radio" name="relation" value="parent" checked /> {p.parent}</label>
            <label class="chk"><input type="radio" name="relation" value="guardian" /> {p.guardian}</label>
          </div>
          <label>{p.email}<input type="email" name="contactEmail" required autocomplete="email" /><small>{p.emailHelp}</small></label>
          <label class="chk"><input type="checkbox" name="take" required /> <span>{p.c.take}</span></label>
          <label class="chk"><input type="checkbox" name="data" required /> <span>{p.c.data}</span></label>
          <label class="chk"><input type="checkbox" name="image" required /> <span>{p.c.image}</span></label>
          <label class="chk"><input type="checkbox" name="prizes" required /> <span>{p.c.prizes}</span></label>
          <label class="chk"><input type="checkbox" name="fundraising" required /> <span>{p.c.fundraising}</span></label>
        </fieldset>
        <div class="cta" style="margin-top:20px"><button class="btn" type="submit" id="accept">{p.accept}</button><button class="btn ghost" type="button" id="refuse">{p.refuse}</button></div>
      </div>
      <div id="withdraw-box" hidden>
        <h2>{p.withdrawH}</h2><p>{p.withdrawText}</p>
        <div class="cta"><button class="btn ghost" type="button" id="withdraw">{p.withdraw}</button></div>
      </div>
    </form>
  </div></section>
  <script is:inline>
  (function () {
    var form = document.getElementById('pc'), q = new URLSearchParams(location.search), token = q.get('t') || '';
    var test = !form.dataset.endpoint, withdraw = q.get('withdraw') === '1';
    var msg = document.getElementById('pcmsg'), ok = document.getElementById('pcok');
    var tokenOk = /^[A-Za-z0-9_-]{16,128}$/.test(token);
    if (!tokenOk && !test) { msg.hidden = false; document.getElementById('main-form').hidden = true; return; }
    if (withdraw) { document.getElementById('main-form').hidden = true; document.getElementById('withdraw-box').hidden = false; }
    function send(decision) {
      msg.hidden = true;
      var data = { version: 1, type: 'parental-consent', decision: decision, token: token, pageLang: form.dataset.lang, submittedAt: new Date().toISOString() };
      if (decision === 'accepted') {
        if (!form.reportValidity()) return;
        data.parentName = form.elements.parentName.value.trim(); data.relation = form.querySelector('input[name=relation]:checked').value;
        data.contactEmail = form.elements.contactEmail.value.trim().toLowerCase();
        data.consents = { participation: true, data: true, image: true, prizes: true, fundraising: true };
      }
      var done = function () { ok.textContent = form.dataset['done' + decision.charAt(0).toUpperCase() + decision.slice(1)]; ok.hidden = false;
        document.getElementById('main-form').hidden = true; document.getElementById('withdraw-box').hidden = true; ok.scrollIntoView({ block: 'center', behavior: 'smooth' }); };
      if (test) return done();
      fetch(form.dataset.endpoint, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=UTF-8' }, body: JSON.stringify(data) })
        .then(done).catch(function () { msg.textContent = form.dataset.err; msg.hidden = false; });
    }
    form.addEventListener('submit', function (e) { e.preventDefault(); send('accepted'); });
    document.getElementById('refuse').addEventListener('click', function () { send('refused'); });
    document.getElementById('withdraw').addEventListener('click', function () { send('withdrawn'); });
  })();
  </script>
</Base>
