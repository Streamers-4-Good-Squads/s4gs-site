---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import DonateBlock from '../../../components/DonateBlock.astro';
import { READY_CODES } from '../../../i18n/locales';
import { assocPage, cupPage } from '../../../i18n/pages';
import { ui } from '../../../i18n/ui';
import { path, fmtSpan, fmtDate } from '../../../i18n/utils';
import { SITE } from '../../../config/site';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const t = ui(lang); const a = assocPage(lang); const c = cupPage(lang);
const hues = ['y', 'b', 'g'];
const p = a.streamers; const on = SITE.sections.streamers;
// Plutôt que des fiches par streamer, la page renvoie vers les réseaux de S4Gs (demande d'Allan, 28 nov. 2026)
const socials = [['Discord', SITE.discordUrl], ['Instagram', SITE.socials.instagram], ['TikTok', SITE.socials.tiktok], ['YouTube', SITE.socials.youtube], ['Facebook', SITE.socials.facebook]];
---
<Base lang={lang} slug="streamers" title={p.head.title} description={p.head.description} noindex={!on}>
  <PageHead lang={lang} head={p.head} crumb={t.nav.streamers} sample={on ? '' : p.sample} />
  <section class="alt"><div class="wrap">
    <div class="head"><h2>{p.follow.h2}</h2><p>{p.follow.text}</p></div>
    <div class="logos socials">{socials.map(([n, u]) => <a href={u} target="_blank" rel="noopener">{n}</a>)}</div>
  </div></section>
  <section><div class="wrap"><div class="box"><h2>{p.join.h2}</h2><p>{p.join.text}</p><a class="btn" href={path(lang, 'streamathon')}>{p.join.cta}</a></div></div></section>
</Base>
