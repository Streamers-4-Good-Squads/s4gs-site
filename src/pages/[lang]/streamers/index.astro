---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import DonateBlock from '../../../components/DonateBlock.astro';
import { READY_CODES } from '../../../i18n/locales';
import { assocPage, cupPage } from '../../../i18n/pages';
import { ui } from '../../../i18n/ui';
import { path, fmtSpan, fmtDate } from '../../../i18n/utils';
import { SITE } from '../../../config/site';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const t = ui(lang); const a = assocPage(lang); const c = cupPage(lang);
const hues = ['y', 'b', 'g'];
const p = a.streamers; const on = SITE.sections.streamers;
---
<Base lang={lang} slug="streamers" title={p.head.title} description={p.head.description} noindex={!on}>
  <PageHead lang={lang} head={p.head} crumb={t.nav.streamers} sample={on ? '' : p.sample} />
  <section class="alt"><div class="wrap"><div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
    {p.items.map((x, i) => <article class="card" style={`--c:var(--${hues[i % 3]})`}><div class="av" style={`--c:var(--${hues[i % 3]})`}>{x.n.slice(-1)}</div><h3>{x.n}</h3><p class="small">{x.role} | {x.region}</p></article>)}
  </div></div></section>
  <section><div class="wrap"><div class="box"><h2>{p.join.h2}</h2><p>{p.join.text}</p><a class="btn" href={`mailto:${SITE.contactEmail}?subject=${encodeURIComponent(p.join.subject)}`}>{p.join.cta}</a></div></div></section>
</Base>
