---
import Base from '../../../layouts/Base.astro';
import { READY_CODES } from '../../../i18n/locales';
import { thanksPage } from '../../../i18n/pages';
import { SITE } from '../../../config/site';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const c = thanksPage(lang);
---
<Base lang={lang} slug="merci" title={c.title} description={c.lead} noindex>
  <section class="hero"><div class="wrap">
    <img class="mascot" src="/img/stream-e.webp" alt="" width="120" height="216" />
    <h1>{c.h1}</h1><p class="lead">{c.lead}</p>
  </div></section>
  <section class="alt"><div class="wrap">
    <ul class="list">{c.next.map((n) => <li>{n}</li>)}</ul>
    {SITE.discordUrl && !SITE.discordUrl.includes('REMPLACER') && <p><a class="btn ghost" href={SITE.discordUrl} target="_blank" rel="noopener">Discord</a></p>}
  </div></section>
  <section><div class="wrap"><div class="box">
    <h2>{c.donate.h2}</h2><p>{c.donate.text}</p>
    <div class="amts" aria-hidden="true"><span>5 €</span><span>10 €</span><span>20 €</span></div>
    <div class="cta" id="don">
      <a class="btn y" id="pay" href={SITE.donationUrl} target="_blank" rel="noopener">{c.donate.cta}</a>
      <button class="btn ghost" id="share" type="button" data-text={c.donate.shareText} data-url={SITE.donationUrl}>{c.donate.share}</button>
    </div>
    <p class="small" id="minors" hidden>{c.donate.minors}</p>
    <p class="small" id="fund">{c.donate.fund}</p>
    <p class="small">{c.donate.noAdvantage}</p>
    <p class="small"><a href={`/${lang}/mobile-cup/`}>←</a></p>
  </div></div></section>
  <script is:inline>
    // Moins de 18 ans (?a=minor ajouté par le formulaire) : pas de bouton de paiement, partage familial
    var q=new URLSearchParams(location.search).get('a');
    if(q==='minor'){document.getElementById('pay').hidden=true;document.getElementById('minors').hidden=false;document.getElementById('fund').hidden=true}
    document.getElementById('share').addEventListener('click',function(){var b=this,t=b.dataset.text,u=b.dataset.url;
      if(navigator.share){navigator.share({text:t,url:u}).catch(function(){})}else{location.href='https://wa.me/?text='+encodeURIComponent(t+' '+u)}});
  </script>
</Base>
