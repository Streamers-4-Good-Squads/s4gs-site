---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import DonateBlock from '../../../components/DonateBlock.astro';
import { READY_CODES } from '../../../i18n/locales';
import { assocPage, cupPage } from '../../../i18n/pages';
import { ui } from '../../../i18n/ui';
import { path, fmtSpan, fmtDate } from '../../../i18n/utils';
import { SITE } from '../../../config/site';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const t = ui(lang); const a = assocPage(lang); const c = cupPage(lang);
const hues = ['y', 'b', 'g'];
const p = a.association;
---
<Base lang={lang} slug="association" title={p.head.title} description={p.head.description}>
  <PageHead lang={lang} head={p.head} crumb={t.nav.association}><div class="cta"><a class="btn y" href={SITE.donationUrl} target="_blank" rel="noopener">{t.donate}</a></div></PageHead>
  <section class="alt"><div class="wrap prose"><h2>{p.story.h2}</h2>{p.story.paras.map((x) => <p>{x}</p>)}</div></section>
  <section><div class="wrap">
    <div class="head"><div><h2>{p.missions.h2}</h2><p>{p.missions.intro}</p></div></div>
    <div class="cards">{a.home.missions.map((m, i) => <div class="card" style={`--c:var(--${hues[i]})`}><h3>{m.h3}</h3><p>{m.text}</p></div>)}</div>
  </div></section>
  <section class="alt"><div class="wrap"><div class="big">
    <span class="tag">{p.partner.tag}</span><h2>{p.partner.h3}</h2><p>{p.partner.text}</p>
    <ul class="list">{p.partner.points.map((x) => <li><strong>{x.h3}</strong> : {x.text}</li>)}</ul>
    <div class="cta"><a class="btn y" href={SITE.donationUrl} target="_blank" rel="noopener">{p.partner.cta}</a></div>
  </div></div></section>
  <section><div class="wrap two">
    <div class="card" style="--c:var(--b)"><h3>{t.footer.mission}</h3><p>{p.mission.text}</p><p><a class="btn ghost" href={path(lang, 'mission')}>{p.mission.cta}</a></p></div>
    {SITE.sections.transparency && <div class="card" style="--c:var(--g)"><h3>{p.transparency.h2}</h3><p>{p.transparency.text}</p><p><a class="btn ghost" href={path(lang, 'transparency')}>{p.transparency.cta}</a></p></div>}
  </div></section>
</Base>
