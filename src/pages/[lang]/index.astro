---
import Base from '../../layouts/Base.astro';
import DonateBlock from '../../components/DonateBlock.astro';
import { READY_CODES } from '../../i18n/locales';
import { cupPage, homePage, assocPage } from '../../i18n/pages';
import { ui } from '../../i18n/ui';
import { path, fmtDate } from '../../i18n/utils';
import { SITE } from '../../config/site';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const t = ui(lang); const h = homePage(lang); const c = cupPage(lang); const a = assocPage(lang); const ah = a.home;
const on = SITE.sections;
const hues = ['y', 'b', 'g'];
const fr = lang === 'fr';
const chips = fr ? ['16 déc → 31 janv', 'Gratuit', 'Inscriptions bientôt'] : ['Dec 16 → Jan 31', 'Free', 'Sign-ups soon'];
const ICONS = [
  '<path d="M12 21s-7-4.6-9.3-9.1C1.2 8.6 3 5 6.4 5c2 0 3.4 1.2 4.1 2.4h3C14.200 6.200 15.600 5 17.600 5 21 5 22.800 8.600 21.300 11.900 19 16.400 12 21 12 21z"/>',
  '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.300 2.700-6 6-6s6 2.700 6 6"/><circle cx="17.500" cy="9" r="2.500"/><path d="M17 14c2.500 0 4.500 2 4.500 4.500"/>',
  '<path d="M3 10v4h3l7 4V6L6 10H3z"/><path d="M16.500 8.500a5 5 0 0 1 0 7"/><path d="M19 6a8.500 8.500 0 0 1 0 12"/>',
];
---
<Base lang={lang} title={h.title} description={h.description}>
  <section class="hero"><div class="wrap sec"><div class="in">
    <div>
      <div class="kick">{ah.kick}</div>
      <h1 class="kin">{ah.h1.split(' ').map((w, i) => <Fragment><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</Fragment>)}</h1>
      <p class="lead">{ah.lead}</p>
      <div class="cta">
        <a class="pill pri" href={path(lang, 'mobile-cup')}>{ah.cupBtn}</a>
        <a class="pill don" href={SITE.donationUrl} target="_blank" rel="noopener">{ah.give}</a>
        <a class="pill sec2" href={SITE.discordUrl} target="_blank" rel="noopener">{ah.join}</a>
      </div>
    </div>
    <div class="vis" aria-hidden="true">
      <div class="orb"></div><div class="d1"></div><div class="d2"></div>
      <div class="fig"><div class="fi"><img src="/img/stream-e.webp" alt="" width="420" height="756" /></div></div>
      <div class="chipf c1">{chips[0]}</div><div class="chipf c2">{chips[1]}</div><div class="chipf c3"><i></i> {chips[2]}</div>
    </div>
  </div></div></section>
  <div class="mq" aria-hidden="true"><div>{[0, 1].map(() => [0, 1, 2, 3].map(() => ['Gaming', 'Streaming', fr ? 'Solidarité' : 'Solidarity'].map((x) => <span>{x} ●</span>)))}</div></div>
  <section class="sec wrap"><div class="head"><div><div class="kick">{ah.assoc.kick}</div><h2>{ah.assoc.h2}</h2><p>{ah.assoc.lead}</p></div><a class="pill sec2" href={path(lang, 'association')}>{ah.assoc.more}</a></div></section>
  <section class="stk">{ah.missions.map((m, i) => <article class="sc" style={`--i:${i};--c:var(--${hues[i]})`}>
    <div class="sct"><span class="stag">{fr ? 'Mission' : 'Mission'} {i + 1}</span><div class="sic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]} /></div><h3>{m.h3}</h3><p>{m.text}</p></div>
    <div class="scv" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[i]} /></div>
  </article>)}</section>
  {on.stats && <section class="sec wrap">
    <div class="head"><div><div class="kick">{ah.stats.kick}</div><h2>{ah.stats.h2}</h2></div></div>
    <div class="stats">{ah.stats.items.map((s) => <div class="stat"><b>{s.v}</b><span>{s.l}</span></div>)}</div>
  </section>}
  <section class="band"><div class="sec wrap">
    <div class="head"><div><div class="kick">{ah.events.kick}</div><h2>{ah.events.h2}</h2></div><a class="pill sec2" href={path(lang, 'events')}>{ah.events.all}</a></div>
    <div class="ev">
      <div class="big"><span class="tag">{c.hero.free}</span><h3>{h.events.cup.h3}</h3><p>{h.events.cup.text}</p><a class="pill don" href={path(lang, 'mobile-cup')}>{h.events.cup.cta}</a></div>
      <div class="card"><h3>{h.events.stream.h3}</h3><p>{h.events.stream.text}</p></div>
    </div>
  </div></section>
  {on.news && <section class="sec wrap">
    <div class="head"><div><div class="kick">{ah.news.kick}</div><h2>{ah.news.h2}</h2></div><a class="pill sec2" href={path(lang, 'news')}>{ah.news.all}</a></div>
    <div class="grid3">{[...a.news.posts].sort((x, y) => y.date.localeCompare(x.date)).slice(0, 3).map((x) => <article class="card news">{(x as any).img && <img class="nimg" src={(x as any).img} alt="" loading="lazy" />}<span class="meta">{fmtDate(x.date, lang, { day: 'numeric', month: 'long', year: 'numeric' })}</span><h3>{x.t}</h3><p>{x.p}</p></article>)}</div>
  </section>}
  {on.partners && <section class="alt sec wrap">
    <div class="head"><div><h2>{ah.partners.h2}</h2></div><a class="pill sec2" href={path(lang, 'partners')}>{ah.partners.all}</a></div>
    <div class="logos">{a.partners.groups.flatMap((g) => g.names).slice(0, 6).map((n) => <div>{n}</div>)}</div>
  </section>}
  <section class="sec wrap">
    <div class="head"><div><h2>{h.help.h2}</h2></div></div>
    <div class="grid3">{h.help.items.map((x, i) => <div class="card"><div class="ic" style={`background:var(--${hues[i]})`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]} /></div><h3>{x.h3}</h3><p>{x.text}</p></div>)}</div>
  </section>
  <section class="alt"><div class="wrap sec"><DonateBlock d={{ ...c.donate, text: lang === 'fr' ? 'Un don, même modeste, soutient les enfants des rues et les jeunes mères mineures aux Philippines, ainsi que les enfants victimes d’abus dans le monde.' : 'A donation, however small, supports street children and underage young mothers in the Philippines, as well as child victims of abuse worldwide.' }} /></div></section>
</Base>
