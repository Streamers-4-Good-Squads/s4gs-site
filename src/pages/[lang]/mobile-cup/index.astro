---
import Base from '../../../layouts/Base.astro';
import DonateBlock from '../../../components/DonateBlock.astro';
import { READY_CODES } from '../../../i18n/locales';
import { cupPage } from '../../../i18n/pages';
import { ui } from '../../../i18n/ui';
import { fmtRange } from '../../../i18n/utils';
import { EVENT } from '../../../data/event';
import { SITE } from '../../../config/site';
import RegisterForm from '../../../components/RegisterForm.astro';
import Countdown from '../../../components/Countdown.astro';
export function getStaticPaths() { return READY_CODES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: string };
const t = ui(lang); const c = cupPage(lang);
const zoneLabels = Object.fromEntries(EVENT.zones.map((z) => [z.id, `${c.zones.names[z.id]} (${z.from.replace(':00', ' h')} - ${z.to.replace(':00', ' h')})`]));
const hues = ['y', 'b', 'g', 'lav', 'y'];
---
<Base lang={lang} slug="mobile-cup" title={c.title} description={c.description}>
  <section class="hero"><div class="wrap">
    <img class="mascot" src="/img/stream-e.webp" alt="" width="120" height="216" />
    <div class="kick">{c.hero.kicker}</div>
    <h1>{c.hero.h1}</h1><p class="lead">{c.hero.lead}</p>
    <span class="pillb">{c.hero.free}</span>
    <div><Countdown lang={lang} end="2027-02-01T00:00:00+01:00" steps={[
      { at: '2026-12-16T00:00:00+01:00', label: c.hero.count.open },
      { at: '2027-01-16T15:00:00+01:00', label: c.hero.count.q1 },
      { at: '2027-01-30T14:00:00+01:00', label: c.hero.count.finals },
    ]} /></div>
    <div class="cta"><a class="btn" href="#inscription">{t.register}</a><a class="btn ghost" href={SITE.donationUrl} target="_blank" rel="noopener">{t.donate}</a></div>
  </div></section>

  <section class="alt"><div class="wrap">
    <h2>{c.dates.h2}</h2>
    <ul class="tl">
      {EVENT.dates.map((d, i) => (
        <li style={`--c:var(--${hues[i]})`}><b>{fmtRange(d.date, (d as any).end, lang)}</b><span>{c.dates.items[d.id]}</span></li>
      ))}
    </ul>
  </div></section>

  <section><div class="wrap">
    <h2>{c.games.h2}</h2><p>{c.games.intro}</p>
    <div class="cards">
      <div class="card" style="--c:var(--b)"><h3>Clash Royale</h3><p>{c.games.crText}</p></div>
      <div class="card" style="--c:var(--g)"><h3>Brawl Stars</h3><p>{c.games.bsText}</p></div>
      <div class="card" style="--c:var(--y)"><h3>{c.games.open}</h3><p>{c.games.openText}</p></div>
      <div class="card" style="--c:var(--lav)"><h3>{c.games.discovery}</h3><p>{c.games.discoveryText}</p></div>
    </div>
    <p class="small">{c.games.mixed}</p>
  </div></section>

  <section class="alt"><div class="wrap">
    <h2>{c.zones.h2}</h2><p>{c.zones.intro}</p>
    <div class="zones">
      {EVENT.zones.map((z) => (
        <div class="zone" style={`--c:var(--${z.hue})`}><b>{c.zones.names[z.id]}</b><span>{z.from.replace(':00', ' h')} - {z.to.replace(':00', ' h')}</span><small>{c.zones.tz}</small></div>
      ))}
    </div>
  </div></section>

  <section><div class="wrap">
    <h2>{c.format.h2}</h2>
    <ul class="list">{c.format.items.map((i) => <li>{i}</li>)}</ul>
  </div></section>

  <section class="alt" id="inscription"><div class="wrap"><div class="box">
    <h2>{c.register.h2}</h2><p>{c.register.text}</p>
    {SITE.registrations.count > 0 && <p><span class="counter">{SITE.registrations.count}</span><br />{c.register.counter}</p>}
    <p class="small">{c.register.ages}</p>
    <RegisterForm lang={lang} zones={zoneLabels} />
  </div></div></section>

  <section><div class="wrap"><DonateBlock d={c.donate} /></div></section>

  <section class="alt" id="collecte"><div class="wrap">
    <h2>{c.fund.h2}</h2><p>{c.fund.intro}</p>
    <ul class="list">{c.fund.items.map((i) => <li>{i}</li>)}</ul>
    <div class="box"><p>{c.fund.continents}</p></div>
    <p class="small">{c.fund.minors}</p>
  </div></section>

  <section id="guide-collecte"><div class="wrap">
    <div class="head"><h2>{c.guide.h2}</h2><p>{c.guide.intro}</p></div>
    <ol class="gsteps">{c.guide.steps.map((s) => <li><h3>{s.h3}</h3><p>{s.text}</p></li>)}</ol>
    <div class="cta" style="margin:8px 0 26px">{SITE.fundraisingUrl
      ? <a class="btn y" href={SITE.fundraisingUrl} target="_blank" rel="noopener">{c.guide.cta}</a>
      : <p class="box small" style="margin:0">{c.guide.soon}</p>}</div>
    <div class="ev">
      <div class="card"><h3>{c.guide.message.h3}</h3><p class="msg">{c.guide.message.text}</p></div>
      <div class="card"><h3>{c.guide.minors.h3}</h3><p>{c.guide.minors.text}</p></div>
    </div>
    <h3 style="margin-top:28px">{c.guide.tips.h3}</h3>
    <ul class="list">{c.guide.tips.items.map((i) => <li>{i}</li>)}</ul>
  </div></section>

  <section><div class="wrap"><p class="small">{c.disclaimer}</p></div></section>
</Base>
