---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ui } from '../i18n/ui';
import { path } from '../i18n/utils';
import { SITE } from '../config/site';
const { lang, slug = '' } = Astro.props;
const t = ui(lang);
const on = SITE.sections;
// Rubriques du menu : celles dont le contenu n'est pas prêt restent masquées (voir config/site.ts)
const items = [
  { slug: '', label: t.nav.home, show: true },
  { slug: 'association', label: t.nav.association, show: true },
  { slug: 'events', label: t.nav.events, show: true },
  { slug: 'news', label: t.nav.news, show: on.news },
  { slug: 'streamers', label: t.nav.streamers, show: on.streamers },
  { slug: 'partners', label: t.nav.partners, show: on.partners },
  { slug: 'contact', label: t.nav.contact, show: true },
].filter((i) => i.show);
// La Mobile Cup, ses pages juridiques et le formulaire appartiennent à la rubrique Événements
const inEvents = ['events', 'mobile-cup', 'rules', 'faq', 'merci', 'parents', 'prizes', 'football-cup'].includes(slug);
const cur = (s: string) => ((s === 'events' ? inEvents : slug === s) ? 'page' : undefined);
---
<div class="spot">{t.spot}<a href={path(lang, 'mobile-cup')}>{t.register} →</a></div>
<header class="hd">
  <div class="wrap">
    <a class="brand" href={path(lang)}><i aria-hidden="true"></i><span>S4GS</span></a>
    <nav class="nav" aria-label="Menu">
      {items.map((i) => <a class="l" href={path(lang, i.slug)} aria-current={cur(i.slug)}>{i.label}</a>)}
    </nav>
    <div class="tools">
      <a class="btn y sm" href={SITE.donationUrl} target="_blank" rel="noopener">{t.donate}</a>
      <LanguageSwitcher lang={lang} slug={slug} />
      <button class="ico" data-theme-toggle aria-label={t.theme} title={t.theme}><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg></button>
      <button class="ico burger" data-burger aria-label={t.menu} aria-expanded="false"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    </div>
  </div>
</header>
