---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ui } from '../i18n/ui';
import { path } from '../i18n/utils';
import { SITE } from '../config/site';
const { lang, slug = '' } = Astro.props;
const t = ui(lang);
const on = SITE.sections;
// Menu : rubriques principales, avec sous-menus déroulants. Les rubriques dont le contenu n'est pas prêt restent masquées (content.json, sections).
type Item = { slug: string; label: string; show?: boolean; also?: string[]; sub?: Item[] };
const items: Item[] = [
  { slug: '', label: t.nav.home },
  // « À propos » regroupe l'association et le contact
  { slug: 'association', label: t.nav.about, sub: [
    { slug: 'association', label: t.nav.association },
    { slug: 'mission', label: t.footer.mission },
    { slug: 'partners', label: t.nav.partners, show: on.partners },
    { slug: 'transparency', label: t.footer.transparency, show: on.transparency },
    { slug: 'participate', label: t.footer.participate },
    { slug: 'donate', label: t.footer.donate },
    { slug: 'contact', label: t.nav.contact },
  ] },
  // La Mobile Cup, ses pages juridiques et le formulaire appartiennent à la rubrique Événements
  { slug: 'events', label: t.nav.events, sub: [
    { slug: 'mobile-cup', label: t.footer.cup, also: ['rules', 'faq', 'merci', 'parents', 'prizes'] },
    { slug: 'streamathon', label: 'Streamathon 2027' },
    { slug: 'streamathon-2026', label: 'Streamathon 2026' },
    // Affichées dans le menu à la demande d'Allan, même si la rubrique n'est pas encore activée (mention « Exemple » et noindex conservés)
    { slug: 'streamers', label: t.nav.streamers },
    { slug: 'news', label: t.nav.news },
  ] },
];
const visible = (l: Item[]) => l.filter((i) => i.show !== false).map((i) => ({ ...i, sub: i.sub ? visible(i.sub) : undefined }));
const menu = visible(items);
const hit = (i: Item): boolean => slug === i.slug || !!i.also?.includes(slug) || !!i.sub?.some(hit);
const cur = (i: Item) => (hit(i) ? 'page' : undefined);
---
<div class="spot"><strong>Mobile Cup</strong><span>{t.spot}</span><a href={path(lang, 'mobile-cup')}>{t.register}</a></div>
<div class="zebra"></div>
<header class="stick" data-stick><i class="prog"></i>
  <nav class="top" aria-label="Menu">
    <a class="logo" href={path(lang)} aria-label="S4Gs"><span class="med"></span><span><b>Streamers</b> <i>4 Good Squads</i></span></a>
    <button class="burger" data-burger aria-expanded="false" aria-controls="menu">{t.menu}</button>
    <div class="links" id="menu">
      {menu.map((i, n) => i.sub?.length ? (
        <div class="dd">
          <a class="l" href={path(lang, i.slug)} aria-current={cur(i)}>{i.label}</a>
          <button class="ddb" type="button" aria-expanded="false" aria-controls={`dd${n}`} aria-label={`${t.nav.submenu} : ${i.label}`}><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="ddm" id={`dd${n}`}>{i.sub.map((x) => <a href={path(lang, x.slug)} aria-current={slug === x.slug || x.also?.includes(slug) ? 'page' : undefined}>{x.label}</a>)}</div>
        </div>
      ) : <a class="l" href={path(lang, i.slug)} aria-current={cur(i)}>{i.label}</a>)}
    </div>
    <button class="tgl" data-theme-toggle role="switch" aria-checked="false" aria-label={t.theme} title={t.theme}>
      <svg class="s1" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/></g></svg>
      <svg class="s2" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"/></svg>
      <span class="k"></span>
    </button>
    <div class="navright" id="menu-right">
      <LanguageSwitcher lang={lang} slug={slug} />
      <a class="pill don" href={path(lang, 'donate')}>{t.donate}</a>
    </div>
  </nav>
</header>
