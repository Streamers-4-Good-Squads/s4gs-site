---
import { ui } from '../i18n/ui';
import { path } from '../i18n/utils';
import { SITE } from '../config/site';
const { lang } = Astro.props; const t = ui(lang);
const on = SITE.sections;
const site = [
  { slug: 'association', label: t.nav.association, show: true },
  { slug: 'events', label: t.nav.events, show: true },
  { slug: 'mobile-cup', label: t.footer.cup, show: true },
  { slug: 'participate', label: t.footer.participate, show: true },
  { slug: 'donate', label: t.footer.donate, show: true },
  { slug: 'news', label: t.nav.news, show: on.news },
  { slug: 'streamers', label: t.nav.streamers, show: on.streamers },
  { slug: 'partners', label: t.nav.partners, show: on.partners },
  { slug: 'contact', label: t.nav.contact, show: true },
].filter((i) => i.show);
---
<footer class="ft"><div class="zebra"></div><div class="wrap">
  <div class="cols">
    <div>
      <div class="logo" style="margin-bottom:12px"><span class="med"></span><span>Streamers 4 Good Squads</span></div>
      <p>{t.footer.tagline}</p>
      <p>{SITE.address}</p>
    </div>
    <div><h3>{t.footer.site}</h3><ul>
      <li><a href={path(lang)}>{t.nav.home}</a></li>
      {site.map((i) => <li><a href={path(lang, i.slug)}>{i.label}</a></li>)}
      <li><a href={path(lang, 'rules')}>{t.footer.rules}</a></li>
      <li><a href={path(lang, 'faq')}>{t.footer.faq}</a></li>
    </ul></div>
    <div><h3>{t.footer.follow}</h3><ul>
      <li><a href={SITE.discordUrl} target="_blank" rel="noopener">Discord</a></li>
      <li><a href={SITE.socials.facebook} target="_blank" rel="noopener">Facebook</a></li>
      <li><a href={SITE.socials.instagram} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={SITE.socials.youtube} target="_blank" rel="noopener">YouTube</a></li>
      <li><a href={SITE.socials.tiktok} target="_blank" rel="noopener">TikTok</a></li>
    </ul></div>
    <div><h3>{t.footer.legal}</h3><ul>
      <li><a href={path(lang, 'privacy')}>{t.footer.privacy}</a></li>
      <li><a href={path(lang, 'terms')}>{t.footer.terms}</a></li>
      <li><a href={path(lang, 'cookies')} data-cookie-settings>{t.footer.cookies}</a></li>
      {on.transparency && <li><a href={path(lang, 'transparency')}>{t.footer.transparency}</a></li>}
      <li><a href={`mailto:${SITE.contactEmail}`}>{t.footer.contact}</a></li>
    </ul></div>
  </div>
  <div class="legal"><span>© {new Date().getFullYear()} Streamers 4 Good Squads ASBL | {t.footer.rights}</span><span class="small">{t.footer.supercell}</span></div>
</div></footer>
