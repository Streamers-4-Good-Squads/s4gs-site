---
import '../styles/global.css';
import '../styles/design.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateStrip from '../components/DonateStrip.astro';
import Videos from '../components/Videos.astro';
import { READY } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { SITE } from '../config/site';
interface Props { lang: string; title: string; description: string; slug?: string; noindex?: boolean }
const { lang, title, description, slug = '', noindex = false, noVideos = false } = Astro.props;
const t = ui(lang);
const p = (l: string) => `${SITE.url}/${l}/${slug ? slug + '/' : ''}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="canonical" href={p(lang)} />
  {READY.map((l) => <link rel="alternate" hreflang={l.code} href={p(l.code)} />)}
  <link rel="alternate" hreflang="x-default" href={p('en')} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/webp" href="/img/logo-pastel.webp" />
  <link rel="apple-touch-icon" href="/img/logo-pastel.webp" />
  <meta name="theme-color" content="#5C2D91" />
  <link rel="preload" href="/fonts/display-100-700.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (function(){try{var s=localStorage.getItem('s4gs-theme');var d=s?s==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=d?'dark':'light'}catch(e){}})();
  </script>
  {Astro.url.pathname.startsWith(`/${lang}/`) && <script is:inline define:vars={{ lang }}>try{localStorage.setItem('s4gs-lang',lang)}catch(e){}</script>}
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <div class="site">
  <Header lang={lang} slug={slug} />
  <main id="main"><slot />{!noVideos && <Videos lang={lang} slug={slug} />}</main>
  {!['mission', 'merci', 'parents'].includes(slug) && <DonateStrip lang={lang} />}
  <Footer lang={lang} />
  </div>
  <script is:inline>
    (function(){
      var root=document.documentElement;
      function sync(){document.querySelectorAll('[data-theme-toggle]').forEach(function(b){b.setAttribute('aria-checked',root.dataset.theme==='dark')})}
      sync();
      document.querySelectorAll('[data-theme-toggle]').forEach(function(b){b.addEventListener('click',function(){var n=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=n;try{localStorage.setItem('s4gs-theme',n)}catch(e){}sync()})});
      var bg=document.querySelector('[data-burger]');
      if(bg)bg.addEventListener('click',function(){var o=!document.querySelector('.links').classList.contains('open');document.querySelectorAll('.links,.navright').forEach(function(n){n.classList.toggle('open',o)});bg.setAttribute('aria-expanded',o)});
      // Sous-menus : le bouton ouvre ou ferme, Échap et un clic ailleurs ferment
      var dds=[].slice.call(document.querySelectorAll('.dd'));function shut(x){dds.forEach(function(d){if(d!==x){d.classList.remove('open');d.querySelector('.ddb').setAttribute('aria-expanded','false')}})}
      dds.forEach(function(d){var b=d.querySelector('.ddb');b.addEventListener('click',function(e){e.stopPropagation();var o=!d.classList.contains('open');shut(d);d.classList.toggle('open',o);b.setAttribute('aria-expanded',o)})});
      document.addEventListener('click',function(e){if(!e.target.closest('.dd'))shut()});document.addEventListener('keydown',function(e){if(e.key==='Escape'){var o=document.querySelector('.dd.open');shut();if(o)o.querySelector('.ddb').focus()}});
      try{matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(e){if(!localStorage.getItem('s4gs-theme')){root.dataset.theme=e.matches?'dark':'light';sync()}})}catch(e){}
      var rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
      var st=document.querySelector('[data-stick]'),cards=[].slice.call(document.querySelectorAll('.sc')),tick=false;
      function upd(){tick=false;var y=scrollY,h=document.documentElement.scrollHeight-innerHeight;
        if(st){st.classList.toggle('sm',y>90);st.style.setProperty('--p',h>0?Math.min(1,y/h):0)}
        cards.forEach(function(c,i){var nx=cards[i+1],d=0;if(nx&&!rm){var a=c.getBoundingClientRect(),b=nx.getBoundingClientRect();d=Math.min(1,Math.max(0,1-(b.top-a.top)/(a.height*.85)))}c.style.setProperty('--d',d.toFixed(3))})}
      addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});addEventListener('resize',upd);upd();
      var hero=document.querySelector('.hero');
      if(hero&&!rm&&matchMedia('(pointer:fine)').matches)hero.addEventListener('pointermove',function(e){var r=hero.getBoundingClientRect();hero.style.setProperty('--px',((e.clientX-r.left)/r.width-.5).toFixed(3));hero.style.setProperty('--py',((e.clientY-r.top)/r.height-.5).toFixed(3))});
      document.querySelectorAll('.card').forEach(function(c){c.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-r.left)+'px');c.style.setProperty('--my',(e.clientY-r.top)+'px')})});
    })();
  </script>
  <!-- Mode édition des textes (code demandé, publication via l'espace équipe) : public/edit/editor.js -->
  <a id="s4e-src" href="/edit/editor.js" hidden></a>
  <button class="s4e-btn" type="button" id="s4e-btn" aria-label={lang === 'fr' ? 'Mode édition' : 'Edit mode'} title={lang === 'fr' ? 'Mode édition' : 'Edit mode'}>✎</button>
  <script is:inline>
    document.getElementById('s4e-btn').addEventListener('click',function(){if(window.S4E)return S4E.start();var s=document.createElement('script');s.src=document.getElementById('s4e-src').href;s.onload=function(){S4E.start()};document.body.appendChild(s)});
  </script>
</body>
</html>
