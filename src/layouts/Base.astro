---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateStrip from '../components/DonateStrip.astro';
import { READY } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { SITE } from '../config/site';
interface Props { lang: string; title: string; description: string; slug?: string; noindex?: boolean }
const { lang, title, description, slug = '', noindex = false } = Astro.props;
const t = ui(lang);
const p = (l: string) => `${SITE.url}/${l}/${slug ? slug + '/' : ''}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="canonical" href={p(lang)} />
  {READY.map((l) => <link rel="alternate" hreflang={l.code} href={p(l.code)} />)}
  <link rel="alternate" hreflang="x-default" href={p('en')} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/webp" href="/img/logo-pastel.webp" />
  <link rel="apple-touch-icon" href="/img/logo-pastel.webp" />
  <meta name="theme-color" content="#5C2D91" />
  <link rel="preload" href="/fonts/display-100-700.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (function(){try{var s=localStorage.getItem('s4gs-theme');var d=s?s==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=d?'dark':'light'}catch(e){}})();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <Header lang={lang} slug={slug} />
  <main id="main"><slot /></main>
  {!['mission', 'merci', 'parents'].includes(slug) && <DonateStrip lang={lang} />}
  <Footer lang={lang} />
  <script is:inline>
    document.querySelectorAll('[data-theme-toggle]').forEach(function(b){b.addEventListener('click',function(){var n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;try{localStorage.setItem('s4gs-theme',n)}catch(e){}})});
    var bg=document.querySelector('[data-burger]');if(bg)bg.addEventListener('click',function(){var n=document.querySelector('.nav');var o=n.classList.toggle('open');bg.setAttribute('aria-expanded',o)});
    try{matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(e){if(!localStorage.getItem('s4gs-theme'))document.documentElement.dataset.theme=e.matches?'dark':'light'})}catch(e){}
  </script>
</body>
</html>
